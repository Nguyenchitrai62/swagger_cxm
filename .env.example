# CXM upstream API
CXM_BASE_URL=https://cxm.erp-uat.hicas.vn

# Use an access token for a quick manual setup.
CXM_ACCESS_TOKEN=
# CXM_ACCESS_TOKEN_FILE=/run/secrets/cxm_access_token

# Recommended for automatic renewal. This file stores only the refresh token,
# never the CXM password. The server creates the parent directory and limits
# the file to owner read/write permissions.
# CXM_REFRESH_TOKEN=
CXM_REFRESH_TOKEN_FILE=./data/cxm-refresh-token
CXM_OAUTH_CLIENT_ID=CxmApi_App
CXM_OAUTH_SCOPE=offline_access CxmApi
# true = require a fresh login at /auth/login after every MCP restart.
# Keep false when the persisted refresh token should restore the session.
CXM_INTERACTIVE_LOGIN=false
# CXM_TENANT_ID=

# MCP server. Use 0.0.0.0 when Docker, another LAN machine, or a reverse proxy
# needs to reach it. Use 127.0.0.1 only for a strictly local-only service.
HOST=0.0.0.0
PORT=9000

# Fixed key protecting both UAT and SIT /mcp endpoints. Accepted as
# ?MCP_KEY=... or Authorization: Bearer ...
MCP_KEY=replace-with-a-long-random-secret
# MCP_API_KEY is retained as a backwards-compatible alias for MCP_KEY.

# Required when HOST is 0.0.0.0 or another non-loopback address.
# Values are hostnames (without scheme or port), separated by commas.
# Add the server's LAN IP and both reverse-proxy/Cloudflare hostnames here.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.10.62,mcp-erp.lm.io.vn,mcp-erp-sit.lm.io.vn
# MCP_ALLOWED_ORIGINS=localhost,127.0.0.1

# Upstream safeguards
CXM_REQUEST_TIMEOUT_MS=30000
CXM_MAX_REQUEST_BYTES=1048576
CXM_MAX_UPLOAD_BYTES=10485760
CXM_MAX_RESPONSE_BYTES=524288
