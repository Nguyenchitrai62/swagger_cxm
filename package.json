{
  "name": "hicas-cxm-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Controlled GET and POST MCP facade for the HICAS CXM API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:tools": "node --env-file-if-exists=.env --import tsx scripts/generate-tools.ts",
    "generate:tools:uat": "node --env-file-if-exists=.env --import tsx scripts/generate-tools.ts --profile uat",
    "generate:tools:sit": "node --env-file-if-exists=.env --import tsx scripts/generate-tools.ts --profile sit",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:watch": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
